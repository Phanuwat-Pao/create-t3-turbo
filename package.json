{
  "name": "create-t3-turbo",
  "private": true,
  "type": "module",
  "scripts": {
    "ncu": "ncu -u",
    "ncu:workspaces": "turbo run ncu",
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "pnpm -F @acme/auth generate",
    "db:push": "turbo -F @acme/db push --ui=tui",
    "db:studio": "turbo -F @acme/db studio",
    "dev": "turbo watch dev --continue -F !@acme/expo",
    "dev:next": "turbo watch dev -F @acme/nextjs...",
    "dev:tui": "turbo watch dev --continue --ui tui",
    "e2e": "turbo run e2e -F @acme/e2e",
    "e2e:debug": "turbo run e2e:debug -F @acme/e2e --ui=tui",
    "e2e:headed": "turbo run e2e:headed -F @acme/e2e",
    "e2e:install": "pnpm --filter @acme/e2e e2e:install",
    "e2e:ui": "turbo run e2e:ui -F @acme/e2e",
    "check": "ultracite check",
    "check:fix": "ultracite fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "prepare": "lefthook install || true",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add --ui=tui",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@turbo/gen": "^2.11.11",
    "dotenv-cli": "^11.1.0",
    "lefthook": "^2.2.2",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "ultracite": "8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0",
    "pnpm": ">=12.23.0"
  },
  "packageManager": "pnpm@12.23.0"
}
