# Full image reference so CI can point the build at a registry proxy-cache
# (avoids Docker Hub's anonymous pull rate limit); defaults to Docker Hub for
# local builds.
#
# Debian, not Alpine like Dockerfile.nextjs: ultimate-express runs on
# uWebSockets.js, which ships glibc builds only and throws on Alpine's musl.
ARG NODE_IMAGE=node:24-trixie-slim

FROM ${NODE_IMAGE} AS node_base_image

# This Dockerfile is copy-pasted into our main docs at /docs/handbook/deploying-with-docker.
# Make sure you update both files!

# setup pnpm and turbo for the build stages; the runner doesn't get them
FROM node_base_image AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
RUN npm i -g corepack@latest
RUN corepack enable
RUN pnpm install turbo --global

FROM base AS pruner
# Set working directory
WORKDIR /app
COPY . .
RUN turbo prune @acme/expressjs --docker

# Add lockfile and package.json's of isolated subworkspace
FROM base AS installer
WORKDIR /app

# First install the dependencies (as they change less often)
COPY .gitignore .gitignore
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --frozen-lockfile

FROM installer AS builder
# Build the project
COPY --from=pruner /app/out/full/ .
COPY turbo.json turbo.json

# Uncomment and use build args to enable remote caching
# ARG TURBO_TEAM
# ENV TURBO_TEAM=$TURBO_TEAM

# ARG TURBO_TOKEN
# ENV TURBO_TOKEN=$TURBO_TOKEN

RUN turbo build --filter=@acme/expressjs...

# The production node_modules, installed with base's tools. The runner copies
# only /app from here, so turbo, corepack's pnpm, the pnpm store and pnpm's
# metadata cache stay out of the image.
FROM base AS deps
WORKDIR /app

COPY .gitignore .gitignore
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
# Installs only apps/expressjs's dependencies. bunchee inlines everything else
# into dist, so workspace packages and the libraries they bring belong in
# devDependencies. In mobile-vaccine, installing the whole pruned workspace
# instead added about 1.1 GB and 57,000 files that nothing loaded. A library
# bunchee can't inline, such as one with native code, has to be listed in
# dependencies to reach the image.
#
# uWebSockets.js, under ultimate-express, ships 24 prebuilt binaries (about
# 125 MB), one per platform and Node ABI, and loads only the one named after
# this image's. The rest are deleted.
RUN pnpm install --prod --frozen-lockfile --filter @acme/expressjs \
  && keep="uws_$(node -p 'process.platform + "_" + process.arch + "_" + process.versions.modules').node" \
  && find node_modules/.pnpm -name 'uws_*.node' ! -name "$keep" -delete

# Starts from the bare Node image, not base: nothing here runs pnpm or turbo.
FROM node_base_image AS runner
WORKDIR /app

# Don't run production as root
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 expressjs

COPY --from=deps /app ./
# Loads ultimate-express, and with it the one uWS binary left, so a build
# without the right binary fails here instead of at startup.
RUN cd apps/expressjs && node -e 'require("ultimate-express")'

USER expressjs

COPY --from=builder --chown=expressjs:nodejs /app/apps/expressjs/dist ./apps/expressjs/dist

ENV NODE_ENV=production

# The image carries no env. The app reads process.env, which compose or the
# cluster sets at runtime.
CMD ["node", "apps/expressjs/dist/index.js"]
